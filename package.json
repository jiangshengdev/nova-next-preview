{
  "name": "nova-next-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@jiangshengdev/nova-next": "3.0.0-alpha.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prettier/plugin-oxc": "^0.0.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.23.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.28.5": "7.29.6",
      "@humanfs/node@0.16.7": "0.16.8",
      "ajv@6.12.6": "6.14.0",
      "baseline-browser-mapping@2.8.31": "2.11.0",
      "brace-expansion@1.1.12": "1.1.21",
      "brace-expansion@2.0.2": "2.1.7",
      "browserslist@4.28.0": "4.28.7",
      "flatted@3.3.3": "3.4.2",
      "js-cookie@3.0.5": "3.0.7",
      "js-yaml@4.1.1": "4.3.2",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.1": "9.0.7",
      "minimatch@9.0.5": "9.0.7",
      "nanoid@3.3.11": "3.3.18",
      "nanoid@5.1.6": "5.1.16",
      "picomatch@4.0.3": "4.0.4",
      "postcss-selector-parser@6.1.2": "6.1.5",
      "postcss@8.5.6": "8.5.23",
      "shell-quote@1.8.3": "1.11.0",
      "source-map-js@1.2.1": "1.2.2",
      "ws@8.18.3": "8.21.0"
    }
  }
}
